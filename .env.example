# ------------------------------------------------------------
# Vitrina · variables de entorno
# Copiá este archivo a .env (composer setup lo hace solo).
# En producción:
# APP_ENV=production, APP_DEBUG=false, LOG_LEVEL=warning,
# SESSION_SECURE_COOKIE=true, DB_CONNECTION=mysql y
# QUEUE_CONNECTION=sync (no hay worker de colas, PLAN D7).
# ------------------------------------------------------------

# --- App ---
APP_NAME=Vitrina
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
# Sin traducciones en lang/es todavía: el respaldo en inglés evita claves crudas. Pasa a "es" en F1.
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# --- Registros ---
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Base de datos ---
# Local: SQLite (database/database.sqlite). Producción: MySQL 8 con las variables de abajo.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=vitrina
# DB_USERNAME=root
# DB_PASSWORD=

# --- Sesión ---
# En producción agregá SESSION_SECURE_COOKIE=true (requiere HTTPS).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# --- Archivos ---
# Las imágenes del sitio usan el disco "public" (storage/app/public). Corré php artisan storage:link una vez.
FILESYSTEM_DISK=local

# --- Caché y colas ---
BROADCAST_CONNECTION=log
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

# --- Servicios no usados por ahora ---
MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Correo ---
# Local: los correos se escriben en storage/logs/laravel.log.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Producción (Brevo SMTP). Las credenciales salen del panel de Brevo; nunca se suben al repo.
# MAIL_MAILER=smtp
# MAIL_HOST=smtp-relay.brevo.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM_ADDRESS="[PENDIENTE: correo remitente verificado en Brevo]"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
